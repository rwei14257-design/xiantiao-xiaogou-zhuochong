{
  "name": "xiantiao-xiaogou-zhuochong",
  "productName": "Puppy Companion",
  "version": "1.1.2",
  "private": true,
  "description": "线条小狗桌宠：可自定义作息的非官方桌面陪伴应用，角色素材由使用者自行提供。",
  "author": "rwei14257-design",
  "license": "MIT",
  "main": "src/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "check:release": "node scripts/check-release.js",
    "test:smoke": "electron . --smoke-test",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64 --publish never",
    "docs:images": "node scripts/generate-illustrations.js"
  },
  "devDependencies": {
    "electron": "42.4.1",
    "electron-builder": "26.15.3"
  },
  "files": [
    "src/*.js",
    "src/*.html",
    "src/*.css",
    "src/assets/*.svg",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "ASSET_POLICY.md",
    "THIRD_PARTY_NOTICES.md"
  ]
}
